{
	"name": "@internal/web",
	"private": true,
	"type": "module",
	"alchemy": {
		"app": "frontend"
	},
	"exports": {
		"./alchemy": "./alchemy.run.ts"
	},
	"scripts": {
		"build:local": "bun --env-file ../../.env.local react-router build --mode production",
		"build:prod": "bun --env-file ../../.env.production react-router build --mode production",
		"sourcemap:upload": "bun posthog/upload-sourcemaps.ts",
		"build:staging": "bun --env-file ../../.env.staging react-router build --mode production",
		"build:dev": "react-router build --mode development",
		"typegen": "bun run rr-typegen",
		"rr-typegen": "react-router typegen",
		"deploy:prod": "alchemy-cli --stage prod deploy",
		"deploy:staging": "alchemy-cli --stage staging deploy",
		"deploy:preview": "alchemy-cli --stage preview deploy",
		"destroy:prod": "alchemy-cli --stage prod destroy",
		"destroy:staging": "alchemy-cli --stage staging destroy",
		"destroy:preview": "alchemy-cli --stage preview destroy",
		"dev": "alchemy-cli --stage local dev",
		"preview": "bun run build:local && vite preview",
		"typecheck": "concurrently -n cloudflare,node -c auto --success all \"tsgo --noEmit -p ./tsconfig.cloudflare.json\" \"tsgo --noEmit -p ./tsconfig.node.json\"",
		"lint": "biome check --write .",
		"lint:format": "biome format --write ."
	},
	"dependencies": {
		"@firtoz/hono-fetcher": "catalog:",
		"@firtoz/maybe-error": "catalog:",
		"@firtoz/router-toolkit": "^9.1.0",
		"@firtoz/socka": "catalog:",
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/fira-code": "^5.2.7",
		"@internal/auth-client": "workspace:*",
		"@internal/auth-db": "workspace:*",
		"@internal/chat-contract": "workspace:*",
		"@internal/db": "workspace:*",
		"@posthog/react": "^1.10.3",
		"@tanstack/react-virtual": "^3.14.5",
		"alchemy-utils": "workspace:*",
		"auth-worker": "workspace:*",
		"better-auth": "catalog:",
		"chatroom-do": "workspace:*",
		"clsx": "^2.1.1",
		"hono": "catalog:",
		"isbot": "^5.1.44",
		"posthog-js": "^1.396.6",
		"posthog-proxy": "workspace:*",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-router": "^8.1.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"state-hub": "workspace:*",
		"@biomejs/biome": "catalog:",
		"@cloudflare/vite-plugin": "^1.43.0",
		"@cloudflare/workers-types": "catalog:",
		"@posthog/cli": "^0.7.34",
		"@react-router/dev": "^8.1.0",
		"@tailwindcss/vite": "^4.3.2",
		"@types/node": "catalog:",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native-preview": "catalog:",
		"alchemy": "catalog:",
		"concurrently": "^10.0.3",
		"portless": "^0.15.1",
		"rollup-plugin-visualizer": "^7.0.1",
		"tailwindcss": "^4.3.2",
		"typescript": "catalog:",
		"vite": "^8.1.3",
		"vite-imagetools": "^10.0.1",
		"vite-plugin-devtools-json": "^1.0.0"
	},
	"packageManager": "bun@1.3.13"
}
