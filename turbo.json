{
	"$schema": "./node_modules/turbo/schema.json",
	"globalDependencies": [
		".env.local",
		".env.production",
		".env.staging",
		"tsconfig.base.json",
		"packages/alchemy-utils/src/password.ts",
		"packages/alchemy-utils/src/env-requirements.ts",
		"packages/alchemy-utils/src/worker-peer-scripts.ts",
		"packages/alchemy-utils/src/deployment-stage.ts",
		"packages/alchemy-utils/src/alchemy-cli.ts",
		"packages/scripts/src/collected-env-requirements.ts",
		"packages/state-hub/alchemy.run.ts"
	],

	"ui": "tui",
	"tasks": {
		"build": {
			"outputLogs": "new-only"
		},
		"build:local": {
			"outputLogs": "new-only"
		},
		"build:staging": {
			"outputLogs": "new-only"
		},
		"typecheck": {
			"outputLogs": "new-only"
		},
		"typegen": {
			"outputLogs": "new-only"
		},
		"dev:preflight": {
			"cache": false,
			"outputLogs": "full"
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"outputLogs": "new-only"
		},
		"deploy:prod": {
			"cache": false,
			"outputLogs": "new-only"
		},
		"deploy:staging": {
			"cache": false,
			"outputLogs": "new-only"
		},
		"deploy:preview": {
			"cache": false,
			"outputLogs": "new-only"
		},
		"destroy:prod": {
			"cache": false,
			"outputLogs": "new-only"
		},
		"destroy:staging": {
			"cache": false,
			"outputLogs": "new-only"
		},
		"destroy:preview": {
			"cache": false,
			"outputLogs": "new-only"
		},
		"chatroom-do#destroy:prod": {
			"dependsOn": ["@internal/web#destroy:prod"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"posthog-proxy#destroy:prod": {
			"dependsOn": ["@internal/web#destroy:prod"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"auth-worker#destroy:prod": {
			"dependsOn": ["@internal/web#destroy:prod", "chatroom-do#destroy:prod"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"@internal/auth-db#destroy:prod": {
			"dependsOn": ["auth-worker#destroy:prod"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"@internal/db#destroy:prod": {
			"dependsOn": ["@internal/web#destroy:prod"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"state-hub#destroy:prod": {
			"dependsOn": [
				"@internal/web#destroy:prod",
				"chatroom-do#destroy:prod",
				"posthog-proxy#destroy:prod",
				"auth-worker#destroy:prod",
				"@internal/auth-db#destroy:prod",
				"@internal/db#destroy:prod"
			],
			"cache": false,
			"outputLogs": "new-only"
		},
		"chatroom-do#destroy:staging": {
			"dependsOn": ["@internal/web#destroy:staging"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"posthog-proxy#destroy:staging": {
			"dependsOn": ["@internal/web#destroy:staging"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"auth-worker#destroy:staging": {
			"dependsOn": ["@internal/web#destroy:staging", "chatroom-do#destroy:staging"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"@internal/auth-db#destroy:staging": {
			"dependsOn": ["auth-worker#destroy:staging"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"@internal/db#destroy:staging": {
			"dependsOn": ["@internal/web#destroy:staging"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"state-hub#destroy:staging": {
			"dependsOn": [
				"@internal/web#destroy:staging",
				"chatroom-do#destroy:staging",
				"posthog-proxy#destroy:staging",
				"auth-worker#destroy:staging",
				"@internal/auth-db#destroy:staging",
				"@internal/db#destroy:staging"
			],
			"cache": false,
			"outputLogs": "new-only"
		},
		"chatroom-do#destroy:preview": {
			"dependsOn": ["@internal/web#destroy:preview"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"posthog-proxy#destroy:preview": {
			"dependsOn": ["@internal/web#destroy:preview"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"auth-worker#destroy:preview": {
			"dependsOn": ["@internal/web#destroy:preview", "chatroom-do#destroy:preview"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"@internal/auth-db#destroy:preview": {
			"dependsOn": ["auth-worker#destroy:preview"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"@internal/db#destroy:preview": {
			"dependsOn": ["@internal/web#destroy:preview"],
			"cache": false,
			"outputLogs": "new-only"
		},
		"state-hub#destroy:preview": {
			"dependsOn": [
				"@internal/web#destroy:preview",
				"chatroom-do#destroy:preview",
				"posthog-proxy#destroy:preview",
				"auth-worker#destroy:preview",
				"@internal/auth-db#destroy:preview",
				"@internal/db#destroy:preview"
			],
			"cache": false,
			"outputLogs": "new-only"
		},
		"lint": {
			"outputLogs": "new-only"
		},
		"lint:format": {
			"outputLogs": "new-only"
		},
		"clean": {
			"cache": false
		},
		"db:generate": {
			"outputLogs": "new-only"
		}
	},
	"globalEnv": [
		"CI",
		"GITHUB_ACTIONS",
		"GITHUB_RUN_ATTEMPT",
		"GITHUB_RUN_NUMBER",
		"CLOUDFLARE_API_TOKEN",
		"CLOUDFLARE_ACCOUNT_ID",
		"ALCHEMY_PASSWORD",
		"ALCHEMY_STATE_TOKEN",
		"CHATROOM_INTERNAL_SECRET",
		"BETTER_AUTH_SECRET",
		"AUTH_ADMIN_SECRET",
		"AUTH_BOOTSTRAP_ADMIN_EMAILS",
		"GOOGLE_CLIENT_ID",
		"GOOGLE_CLIENT_SECRET",
		"GH_CLIENT_ID",
		"GH_CLIENT_SECRET",
		"AUTH_DOMAINS",
		"STAGE",
		"DEPLOY_ENABLED",
		"WEB_DOMAINS",
		"WEB_ROUTES",
		"WEB_ZONE_ID",
		"WEB_DOMAIN_OVERRIDE_EXISTING_ORIGIN",
		"LOCAL_PORTLESS",
		"PORT",
		"PORTLESS_TLD",
		"PORTLESS_URL",
		"POSTHOG_CLI_API_KEY",
		"POSTHOG_CLI_ENV_ID",
		"POSTHOG_CLI_HOST",
		"POSTHOG_CLI_PROJECT_ID",
		"POSTHOG_CLI_TOKEN",
		"POSTHOG_DEPLOY_SOURCE",
		"POSTHOG_KEY",
		"POSTHOG_HOST",
		"POSTHOG_UI_HOST",
		"POSTHOG_REGION",
		"POSTHOG_SITE",
		"POSTHOG_RELEASE_BUILD",
		"POSTHOG_RELEASE_VERSION",
		"TURBO_TELEMETRY_DISABLED"
	]
}
