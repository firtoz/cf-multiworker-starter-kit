{
	"name": "cloudflare-multiworker-template",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/your-org/cloudflare-multiworker-template.git"
	},
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*",
			"workers/*",
			"durable-objects/*"
		],
		"catalog": {
			"@biomejs/biome": "^2.5.2",
			"@cloudflare/workers-types": "^5.20260705.1",
			"@firtoz/hono-fetcher": "^2.8.2",
			"@firtoz/maybe-error": "^1.6.2",
			"@firtoz/socka": "^5.0.2",
			"@firtoz/websocket-do": "^14.0.2",
			"@types/node": "^26.1.0",
			"@typescript/native-preview": "^7.0.0-dev.20260705.1",
			"alchemy": "^0.93.12",
			"better-auth": "^1.6.23",
			"dotenv": "^17.4.2",
			"drizzle-kit": "^0.31.4",
			"drizzle-orm": "^0.45.2",
			"hono": "^4.12.27",
			"typescript": "^6.0.3",
			"zod": "^4.4.2"
		}
	},
	"scripts": {
		"agents:link": "bash .agents/install-symlinks.sh",
		"setup": "bun run --cwd packages/scripts setup",
		"setup:local": "bun run --cwd packages/scripts setup:local",
		"setup:prod": "bun run --cwd packages/scripts setup:prod",
		"setup:staging": "bun run --cwd packages/scripts setup:staging",
		"setup:account": "bun run --cwd packages/scripts setup:account",
		"quickstart": "bun run --cwd packages/scripts quickstart",
		"onboard:staging": "bun run --cwd packages/scripts onboard:staging",
		"onboard:prod": "bun run --cwd packages/scripts onboard:prod",
		"github:setup": "bun run --cwd packages/scripts github:setup",
		"github:setup:staging": "bun run --cwd packages/scripts github:setup:staging",
		"github:setup:prod": "bun run --cwd packages/scripts github:setup:prod",
		"github:sync": "bun run github:sync:staging && bun run github:sync:prod",
		"github:sync:config": "bun run github:sync:config:staging && bun run github:sync:config:prod",
		"github:sync:config:prod": "bunx dotenv-cli -v GITHUB_SYNC_SCOPE=secrets -v GITHUB_SYNC_PUSH_SECRETS=false -- alchemy-cli --stage prod --app admin --entry stacks/admin.ts deploy",
		"github:sync:config:staging": "bunx dotenv-cli -v GITHUB_SYNC_SCOPE=secrets -v GITHUB_SYNC_PUSH_SECRETS=false -- alchemy-cli --stage staging --app admin --entry stacks/admin.ts deploy",
		"github:sync:prod": "bunx dotenv-cli -v GITHUB_SYNC_SCOPE=secrets -- alchemy-cli --stage prod --app admin --entry stacks/admin.ts deploy",
		"github:sync:staging": "bunx dotenv-cli -v GITHUB_SYNC_SCOPE=secrets -- alchemy-cli --stage staging --app admin --entry stacks/admin.ts deploy",
		"github:env": "bun run github:env:staging && bun run github:env:prod",
		"github:env:prod": "bunx dotenv-cli -v GITHUB_SYNC_SCOPE=environment -- alchemy-cli --stage prod --app admin --entry stacks/admin.ts deploy",
		"github:env:staging": "bunx dotenv-cli -v GITHUB_SYNC_SCOPE=environment -- alchemy-cli --stage staging --app admin --entry stacks/admin.ts deploy",
		"deploy:preflight:prod": "bun run --cwd packages/scripts deploy:preflight:prod",
		"deploy:preflight:staging": "bun run --cwd packages/scripts deploy:preflight:staging",
		"deploy:preflight:preview": "bun run --cwd packages/scripts deploy:preflight:preview",
		"auth:sync-bootstrap-admins": "bun run --cwd packages/scripts sync-bootstrap-admins",
		"dev": "turbo run dev --filter=@internal/web --filter=@internal/db --filter=@internal/auth-db --filter=auth-worker --filter=chatroom-do --filter=posthog-proxy",
		"db:generate:auth": "turbo run db:generate --filter=@internal/auth-db",
		"deploy:prod": "turbo run deploy:prod",
		"deploy:staging": "turbo run deploy:staging",
		"deploy:preview": "turbo run deploy:preview",
		"destroy:prod": "turbo run destroy:prod",
		"destroy:staging": "turbo run destroy:staging",
		"destroy:preview": "turbo run destroy:preview",
		"preview:cleanup:orphans": "bun run --cwd packages/scripts preview:cleanup:orphans",
		"build": "turbo run build:local",
		"lint": "turbo lint",
		"lint:format": "turbo lint:format",
		"format": "biome format --write . && biome check --write --only=assist/source/organizeImports ./apps ./packages ./durable-objects ./stacks ./turbo/generators",
		"typecheck": "turbo run typecheck && tsgo --noEmit -p .",
		"typegen": "turbo run typegen",
		"test": "turbo run test",
		"check:drizzle-generated": "bun run --cwd packages/scripts check:drizzle-generated",
		"check:preview-catalog": "bun run --cwd packages/alchemy-utils check:preview-catalog",
		"check:ci-env-wiring": "bun ./packages/scripts/src/check-ci-env-wiring.ts",
		"outdated": "bun outdated --recursive",
		"update:interactive": "bun update --latest --ir",
		"clean": "turbo clean && rm -rf .turbo .alchemy .mf .wrangler && for dir in apps packages workers durable-objects stacks; do [ -d \"$dir\" ] || continue; find \"$dir\" -type d \\( -name .turbo -o -name .alchemy -o -name .mf -o -name .wrangler -o -name dist -o -name build -o -name .react-router \\) -prune -exec rm -rf {} +; find \"$dir\" -name '*.tsbuildinfo' -type f -delete; done",
		"db:generate": "turbo run db:generate --filter=@internal/db"
	},
	"trustedDependencies": [
		"esbuild",
		"msgpackr-extract",
		"sharp",
		"workerd"
	],
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@cloudflare/workers-types": "catalog:",
		"@octokit/rest": "^22.0.1",
		"@turbo/gen": "^2.10.3",
		"@types/bun": "^1.3.13",
		"@typescript/native-preview": "catalog:",
		"alchemy": "catalog:",
		"alchemy-utils": "workspace:*",
		"better-auth": "^1.6.23",
		"dotenv": "catalog:",
		"dotenv-cli": "^11.0.0",
		"turbo": "^2.10.3",
		"typescript": "catalog:"
	},
	"packageManager": "bun@1.3.13",
	"overrides": {
		"alchemy": "0.93.12"
	}
}
